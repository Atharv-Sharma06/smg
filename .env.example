# Copy to .env (git-ignored) and fill in.
SMG_USERNAME=
SMG_PASSWORD=
# Set to 1 only when you are ready to place real SMG trades (also needs --live).
SMG_LIVE_TRADING=0

# Slack incoming webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Email alerts (e.g. Gmail with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Only if Selenium can't find Chrome/chromedriver on its own
CHROME_BINARY=
CHROMEDRIVER_PATH=
